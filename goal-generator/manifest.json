{
  "name": "goal-generator",
  "version": "2.0.1",
  "mode": "production",
  "archetype": "library",
  "context_budget_tier": "production",
  "description": "把用户提供的原始任务、需求或现象描述转换成高质量的 /goal 完成契约。支持 Standard（产品/功能/文档）和 Diagnostic（Bug/性能/硬件/根因调查）两种 Profile，自动选择。",
  "owner": "zhangjl",
  "review_cadence": "per-major-change",
  "triggers": {
    "strong": [
      "帮我生成 Goal",
      "写一个 goal",
      "构造 goal",
      "把下面任务变成 goal",
      "Goal 化",
      "设计目标契约",
      "帮我定义完成条件",
      "需要 /goal",
      "不要执行，只生成执行目标"
    ],
    "weak": [
      "修复 X 问题",
      "找到根因",
      "优化性能",
      "调查现象",
      "可能是 X 导致",
      "报错、挂死、太慢"
    ]
  },
  "exclusions": [
    "纯一次性命令",
    "简单翻译",
    "一行 shell 输出",
    "尚未确定方向的探索",
    "可直接调试的明确 Bug",
    "纯头脑风暴"
  ],
  "factory_components": {
    "scripts": ["scripts/lint_goal.py"],
    "references": [
      "references/standard-goal-examples.md",
      "references/diagnostic-goal-examples.md",
      "references/default-reference.md",
      "references/discovery-reference.md",
      "references/failure-modes.md"
    ]
  }
}
