{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Webnovel Analysis Output Envelope",
  "description": "Standard output envelope for all S0-S9 analysis skills",
  "type": "object",
  "required": ["task_id", "skill_id", "skill_version", "batch_id"],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Task unique identifier, e.g. BK20260731-001"
    },
    "skill_id": {
      "type": "string",
      "description": "Skill identifier, e.g. S0, S1, Q0"
    },
    "skill_version": {
      "type": "string",
      "description": "Skill version, e.g. 1.0"
    },
    "mode": {
      "type": "string",
      "enum": ["incremental", "consolidation", "calibration"],
      "description": "Execution mode"
    },
    "batch_id": {
      "type": "string",
      "description": "Batch identifier, e.g. BATCH-01"
    },
    "records": {
      "type": "array",
      "description": "Per-chapter analysis results",
      "items": {
        "type": "object"
      }
    },
    "batch_summary": {
      "type": "object",
      "description": "Summary of this batch for next batch context"
    },
    "uncertain_items": {
      "type": "array",
      "description": "Items that cannot be confirmed from text",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Conflicts with previous batch records",
      "items": {
        "type": "object"
      }
    },
    "manual_review_items": {
      "type": "array",
      "description": "Items requiring human review",
      "items": {
        "type": "object"
      }
    }
  }
}
