{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "output-envelope.schema.json",
  "title": "Webnovel Analysis Model Output Envelope",
  "type": "object",
  "required": [
    "task_id", "batch_id", "skill_id", "skill_version", "schema_version",
    "operation", "payload", "uncertain_items", "conflicts", "manual_review_items"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^(TASK|BOOK|BATCH-[A-Za-z0-9_-]+)$"},
    "skill_id": {"enum": ["O0", "S0", "S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8", "S9", "Q0", "R0"]},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "operation": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "uncertain_items": {"type": "array", "items": {"$ref": "common-types.schema.json#/definitions/uncertain_item"}},
    "conflicts": {"type": "array", "items": {"$ref": "common-types.schema.json#/definitions/conflict"}},
    "manual_review_items": {"type": "array", "items": {"$ref": "common-types.schema.json#/definitions/manual_review_item"}}
  },
  "additionalProperties": false
}
