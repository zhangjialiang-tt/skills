  "usage_instructions": [
    "每章一行，主键chapter_id唯一；批量分析时先填S0基础字段再按S1-S5顺序填充",
    "所有枚举值必须来自enums.yaml，组合情绪拆为 主情绪/副情绪 两个字段填写",
    "爽点必须为'已兑现'事件；未兑现期待写入open_loops_added而非payoff字段",
    "反向释放（以死反叛、杀真我）需在reverse_release_note注明，防止Q0跨Skill冲突误报",
    "core_evidence必须引用原文或证据位置，禁止'我记得''大概'等无依据表述",
    "memory_recall_check用于标注分析时是否核对了跨章记忆线（如道具回收、旧悬念）",
    "无事件、无钩子、无爽点时如实填写0/留空/无明显钩子，禁止编造默认值",
    "每批完成后运行S6聚合与Q0审计，P1标记必须进入人工复核队列"
  ],
  "genre_specific_extensions": [
    {"field_name": "memory_recall_check", "display_name": "记忆线核验", "definition": "本章是否核对了跨章记忆/道具回收（如紫纱巾式闭环）", "data_type": "enum", "allowed_values": "pass/fail/partial", "owner_skill": "S1", "note": "宿命/轮回/失忆题材必备，防角色状态倒退"},
    {"field_name": "reverse_release_note", "display_name": "反向释放备注", "definition": "若本章释放为'以死/毁灭/杀真我'式，注明口径供Q0复核", "data_type": "text", "allowed_values": "任意", "owner_skill": "S4", "note": "悲剧文学题材必备，防止被误计为商业爽点"},
    {"field_name": "foreshadow_tool", "display_name": "伏笔道具", "definition": "本章出现的跨章道具/意象及其回收章", "data_type": "text", "allowed_values": "任意", "owner_skill": "S1", "note": "意象/道具循环类题材必备"}
