  "template_name": "单章拆解表（通用核心+西游同人/宿命题材扩展）",
  "field_dictionary": [
    {"field_name": "chapter_id", "display_name": "章节ID", "definition": "任务批次前缀+章节号", "data_type": "string", "required": true, "allowed_values": "BK001-CH0001 格式", "owner_skill": "S0", "empty_value_rule": "禁止为空", "good_example": "BK001-CH0004", "bad_example": "第4章"},
    {"field_name": "chapter_no", "display_name": "章节序号", "definition": "全书自然序号", "data_type": "integer", "required": true, "allowed_values": "1-N", "owner_skill": "S0", "empty_value_rule": "禁止为空", "good_example": 4, "bad_example": "4章"},
    {"field_name": "chapter_title", "display_name": "章节标题", "definition": "原文标题", "data_type": "string", "required": false, "allowed_values": "任意", "owner_skill": "S0", "empty_value_rule": "缺失留空", "good_example": "第四章", "bad_example": ""},
    {"field_name": "word_count", "display_name": "字数", "definition": "清洗后正文字数", "data_type": "integer", "required": true, "allowed_values": "0-10000", "owner_skill": "S0", "empty_value_rule": "0", "good_example": 2917, "bad_example": "约三千"},
    {"field_name": "timeline_id", "display_name": "时间线", "definition": "所属叙事时间线", "data_type": "string", "required": true, "allowed_values": "T-NOW/T-PAST/T-EARLY/T-TRANS/T-PREQUEL/其他", "owner_skill": "S1", "empty_value_rule": "存疑填'存疑'", "good_example": "T-PAST", "bad_example": ""},
    {"field_name": "volume_id", "display_name": "卷ID", "definition": "分析用卷归属", "data_type": "string", "required": true, "allowed_values": "V01-V04/其他", "owner_skill": "S1", "empty_value_rule": "存疑填'存疑'", "good_example": "V02", "bad_example": ""},
    {"field_name": "story_unit_id", "display_name": "故事单元ID", "definition": "事件单元归属", "data_type": "string", "required": true, "allowed_values": "U01-U10/其他", "owner_skill": "S1", "empty_value_rule": "存疑填'存疑'", "good_example": "U06", "bad_example": ""},
    {"field_name": "chapter_function", "display_name": "章节功能", "definition": "主功能（单值）", "data_type": "enum", "required": true, "allowed_values": "enums.yaml chapter_function 全部", "owner_skill": "S1", "empty_value_rule": "禁止为空", "good_example": "阶段高潮", "bad_example": "过渡"},
    {"field_name": "secondary_functions", "display_name": "次要功能", "definition": "附加功能，多值用|分隔", "data_type": "string", "required": false, "allowed_values": "enums.yaml chapter_function", "owner_skill": "S1", "empty_value_rule": "无则留空", "good_example": "展示能力|后果结算", "bad_example": "高潮高潮"},
    {"field_name": "main_event", "display_name": "主事件", "definition": "一章核心情节一句话", "data_type": "text", "required": true, "allowed_values": "任意", "owner_skill": "S1", "empty_value_rule": "禁止为空", "good_example": "孙悟空大闹蟠桃会救阿瑶", "bad_example": "各种事件"},
    {"field_name": "pov_character", "display_name": "POV视角", "definition": "主要叙述视角角色", "data_type": "string", "required": false, "allowed_values": "角色规范名", "owner_skill": "S3", "empty_value_rule": "多视角用|分隔", "good_example": "孙悟空", "bad_example": "猴子"},
    {"field_name": "active_characters", "display_name": "出场角色", "definition": "本章活跃角色，多值用|分隔", "data_type": "string", "required": true, "allowed_values": "角色规范名", "owner_skill": "S3", "empty_value_rule": "禁止为空", "good_example": "孙悟空|王母|阿瑶", "bad_example": "很多人"},
    {"field_name": "relationship_changes", "display_name": "关系变化", "definition": "本章发生的角色关系变化，格式:角色A-角色B:类型前→类型后", "data_type": "text", "required": false, "allowed_values": "任意", "owner_skill": "S3", "empty_value_rule": "无则留空", "good_example": "天篷-阿月:深情→获罪", "bad_example": ""},
    {"field_name": "open_loops_added", "display_name": "新开悬念", "definition": "本章新打开的待闭环悬念，多值用|分隔", "data_type": "text", "required": false, "allowed_values": "任意", "owner_skill": "S1", "empty_value_rule": "无则留空", "good_example": "幕后主使是谁|唐僧魂魄去向", "bad_example": ""},
    {"field_name": "open_loops_closed", "display_name": "闭环悬念", "definition": "本章关闭的旧悬念，多值用|分隔", "data_type": "text", "required": false, "allowed_values": "任意", "owner_skill": "S1", "empty_value_rule": "无则留空", "good_example": "真假悟空谜局", "bad_example": ""},
    {"field_name": "emotion_start", "display_name": "情绪-开头", "definition": "章首情绪基准分", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 3, "bad_example": "平静"},
    {"field_name": "emotion_low", "display_name": "情绪-谷底", "definition": "本章情绪最低分", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 2, "bad_example": ""},
    {"field_name": "emotion_high", "display_name": "情绪-峰值", "definition": "本章情绪最高分", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 9, "bad_example": ""},
    {"field_name": "emotion_end", "display_name": "情绪-结尾", "definition": "章末情绪基准分", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 6, "bad_example": ""},
    {"field_name": "emotion_score", "display_name": "情绪总分", "definition": "本章综合情绪分", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 7, "bad_example": "很high"},
    {"field_name": "pressure_score", "display_name": "压抑分", "definition": "本章压抑强度", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": 7, "bad_example": ""},
    {"field_name": "release_score", "display_name": "释放分", "definition": "本章释放强度", "data_type": "integer", "required": true, "allowed_values": "0-10", "owner_skill": "S2", "empty_value_rule": "无释放填0", "good_example": 5, "bad_example": ""},
    {"field_name": "dominant_emotion", "display_name": "主导情绪", "definition": "本章主导情绪（组合型需人工拆分）", "data_type": "enum", "required": true, "allowed_values": "enums.yaml dominant_emotion", "owner_skill": "S2", "empty_value_rule": "禁止为空", "good_example": "痛快", "bad_example": "压抑后爆发(需拆主副)"},
    {"field_name": "suppression_level", "display_name": "压抑等级", "definition": "0-4级压抑评级", "data_type": "integer", "required": true, "allowed_values": "0-4", "owner_skill": "S4", "empty_value_rule": "无压抑填0", "good_example": 4, "bad_example": 5},
    {"field_name": "payoff_present", "display_name": "是否有爽点", "definition": "本章是否存在已兑现正反馈", "data_type": "boolean", "required": true, "allowed_values": "true/false", "owner_skill": "S4", "empty_value_rule": "禁止为空", "good_example": true, "bad_example": "yes"},
    {"field_name": "payoff_type", "display_name": "爽点类型", "definition": "主爽点类型，无爽点留空", "data_type": "enum", "required": false, "allowed_values": "enums.yaml payoff_type", "owner_skill": "S4", "empty_value_rule": "无爽点留空", "good_example": "群体震惊", "bad_example": "大闹天宫(非枚举)"},
    {"field_name": "payoff_strength", "display_name": "爽点强度", "definition": "主爽点强度，无爽点填0", "data_type": "integer", "required": true, "allowed_values": "0-10", "owner_skill": "S4", "empty_value_rule": "无爽点填0", "good_example": 6, "bad_example": "很爽"},
    {"field_name": "ending_hook", "display_name": "章末钩子", "definition": "章末留下的未完成刺激（与原文最后有效段落一致）", "data_type": "text", "required": true, "allowed_values": "任意", "owner_skill": "S5", "empty_value_rule": "无钩子写'无明显钩子'", "good_example": "孙悟空独守花果山举棒指天',来吧!'", "bad_example": "本章结束"},
    {"field_name": "cliffhanger_type", "display_name": "断章类型", "definition": "断章机制类型", "data_type": "enum", "required": true, "allowed_values": "enums.yaml cliffhanger_type", "owner_skill": "S5", "empty_value_rule": "无明显钩子", "good_example": "反转刚发生", "bad_example": ""},
    {"field_name": "chapter_break_strength", "display_name": "断章强度", "definition": "章末钩子强度", "data_type": "integer", "required": true, "allowed_values": "1-10", "owner_skill": "S5", "empty_value_rule": "禁止为空", "good_example": 8, "bad_example": ""},
    {"field_name": "break_phase", "display_name": "断章相位", "definition": "相对爽点的切断位置", "data_type": "enum", "required": true, "allowed_values": "爽前/爽中/爽后/自然收束", "owner_skill": "S5", "empty_value_rule": "禁止为空", "good_example": "爽中", "bad_example": ""},
    {"field_name": "paywall_suitability", "display_name": "付费适宜性", "definition": "该章作为付费卡点的适宜度", "data_type": "enum", "required": true, "allowed_values": "低/中/高", "owner_skill": "S5", "empty_value_rule": "禁止为空", "good_example": "高", "bad_example": ""},
    {"field_name": "core_evidence", "display_name": "核心证据", "definition": "支撑本行关键判断的原文引文/位置", "data_type": "text", "required": true, "allowed_values": "任意", "owner_skill": "多Skill", "empty_value_rule": "禁止为空", "good_example": "CH0012:1549-1556", "bad_example": "我记得"},
    {"field_name": "analysis_confidence", "display_name": "置信度", "definition": "本章分析置信度", "data_type": "enum", "required": true, "allowed_values": "确定/推断/存疑", "owner_skill": "多Skill", "empty_value_rule": "禁止为空", "good_example": "确定", "bad_example": "maybe"},
    {"field_name": "review_priority", "display_name": "复核优先级", "definition": "Q0判定的人工复核级别", "data_type": "enum", "required": true, "allowed_values": "P0/P1/P2", "owner_skill": "Q0", "empty_value_rule": "默认P2", "good_example": "P1", "bad_example": ""},
    {"field_name": "review_reason", "display_name": "复核原因", "definition": "P1/P0的标记原因", "data_type": "text", "required": false, "allowed_values": "任意", "owner_skill": "Q0", "empty_value_rule": "无标记留空", "good_example": "峰值评分+主要爽点", "bad_example": ""}
  ],
