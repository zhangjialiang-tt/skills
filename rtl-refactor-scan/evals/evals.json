{
  "skill_name": "rtl-refactor-scan",
  "version": "2.0.0",
  "evals": [
    {
      "id": 1,
      "type": "deterministic-audit",
      "prompt": "帮我评审这段 RTL，重点检查综合和时序风险",
      "files": ["evals/fixtures/sample_fixt_known_defects.v"],
      "expected_findings": {
        "min_count": 4,
        "must_include_rules": [
          "SYN-MIXED-BLOCKING-001",
          "CDC-SINGLEBIT-DIRECT-001",
          "CDC-MULTIBIT-DIRECT-001",
          "SYN-VARIABLE-PART-SELECT-001"
        ],
        "rule_axis_expectations": {
          "SYN-VARIABLE-PART-SELECT-001": {"severity": "medium", "actionability": "plan_required"},
          "CDC-MULTIBIT-DIRECT-001": {"severity": "critical", "actionability": "manual_design_required"},
          "CDC-SINGLEBIT-DIRECT-001": {"severity": "critical", "actionability": "manual_design_required"},
          "SYN-MIXED-BLOCKING-001": {"severity": "critical", "actionability": "plan_required"}
        }
      },
      "expectations": [
        "产出 findings.json 而非直接手写 Markdown 报告",
        "findings.json 通过 validate_findings.py 校验",
        "审计报告.md 由 render_report.py 从 findings.json 渲染",
        "variable part-select 标为 medium/plan_required（不再是 A 类）",
        "CDC 规则 severity=critical 但 actionability=manual_design_required",
        "无 evidence_level=E0 的 finding 标为 confirmed"
      ]
    },
    {
      "id": 2,
      "type": "near-neighbor-boundary",
      "prompt": "给这个 Verilog 模块加注释，说明每个状态机的职责",
      "expected_output": "不应触发；路由到 rtl-annotator",
      "expectations": [
        "识别为注释增强请求",
        "建议改用 rtl-annotator skill"
      ]
    },
    {
      "id": 3,
      "type": "mode-boundary",
      "prompt": "快速看下这个模块有没有低级错误",
      "expected_output": "进入 quick 模式（只读），仅输出 critical/high findings",
      "expectations": [
        "识别 quick 模式",
        "不进入 refactor",
        "仅 critical/high findings"
      ]
    },
    {
      "id": 4,
      "type": "mode-boundary",
      "prompt": "扫描这个模块，输出审计报告",
      "expected_output": "默认进入 audit 模式（只读），不修改代码",
      "expectations": [
        "默认 audit 而非 refactor",
        "输出 findings.json + 报告",
        "不修改 RTL"
      ]
    }
  ]
}
