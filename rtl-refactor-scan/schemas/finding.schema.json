{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/finding.schema.json",
  "title": "RTL Audit Finding",
  "description": "唯一权威审计结果（提案 §5.1）。Markdown 报告由 findings.json 渲染生成。",
  "type": "object",
  "properties": {
    "finding_id": {"type": "string", "pattern": "^RTL-[A-Z]+-[0-9]{3}$"},
    "rule_id": {"type": "string", "pattern": "^[A-Z]+-[A-Z0-9-]+-[0-9]{3}$"},
    "category": {"type": "string", "enum": ["synthesis", "reset", "cdc", "handshake", "pipeline", "memory", "timing-heuristic", "debug"]},
    "title": {"type": "string"},
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string"},
          "start_line": {"type": "integer", "minimum": 1},
          "end_line": {"type": "integer", "minimum": 1}
        },
        "required": ["file", "start_line", "end_line"]
      }
    },
    "severity": {"type": "string", "enum": ["critical", "high", "medium", "low", "info"]},
    "confidence": {"type": "string", "enum": ["confirmed", "probable", "hypothesis", "unknown"]},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {"type": {"type": "string"}, "description": {"type": "string"}},
        "required": ["type", "description"]
      }
    },
    "impact": {"type": "array", "items": {"type": "string"}},
    "actionability": {"type": "string", "enum": ["safe_candidate", "plan_required", "manual_design_required", "report_only", "out_of_scope"]},
    "change_policy": {"type": "string", "enum": ["auto_fix_allowed", "do_not_auto_fix", "requires_approval"]},
    "verification_obligations": {"type": "array", "items": {"type": "string"}}
  },
  "required": ["finding_id", "rule_id", "category", "title", "locations", "severity", "confidence", "evidence_level", "evidence", "actionability", "change_policy"],
  "allOf": [
    {
      "if": {"properties": {"confidence": {"const": "confirmed"}}},
      "then": {"properties": {"evidence_level": {"enum": ["E2", "E3", "E4", "E5"]}}}
    }
  ]
}
