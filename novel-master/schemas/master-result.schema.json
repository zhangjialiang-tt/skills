{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "master-result.schema.json",
  "title": "MasterResult",
  "description": "Orchestrator output contract for novel-master V1 (Contract §14)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "request_summary",
    "route_executed",
    "deliverables",
    "confirmed_changes",
    "pending_decisions",
    "warnings",
    "recommended_next_action"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_summary": {
      "type": "string",
      "minLength": 1
    },
    "route_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "mode", "purpose", "status"],
        "properties": {
          "skill": { "type": "string", "minLength": 1 },
          "mode": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "summary"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "confirmed_changes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": {
      "type": ["string", "null"]
    }
  }
}
