{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approval-ref.schema.json",
  "title": "ApprovalRef",
  "description": "Authorization contract for novel-master V1 operations (Contract §7)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "request_id",
    "approved_by",
    "approved_at",
    "operation",
    "approved_scope",
    "based_on_revision",
    "expires_after_use",
    "status"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": "string",
      "const": "user"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string",
      "enum": [
        "COMMIT_CANON",
        "RETCON",
        "EDIT_L3",
        "EDIT_L4",
        "ACCEPT_CHAPTER",
        "INIT_PROJECT",
        "REPLAN_ARC",
        "REPLAN_VOLUME"
      ]
    },
    "approved_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "items"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string" }
        },
        "items": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "based_on_revision": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]*|[A-Za-z][A-Za-z0-9._-]*[0-9])$"
    },
    "expires_after_use": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "USED", "EXPIRED", "REVOKED"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["EDIT_L4", "RETCON"]
          }
        },
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "expires_after_use": {
            "const": true
          }
        },
        "required": ["expires_after_use"]
      }
    }
  ]
}
