{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-spine.schema.json",
  "title": "ProjectSpine",
  "description": "v1.3 ProjectSpine — book-level structure with non-negotiable milestones.",
  "type": "object",
  "additionalProperties": false,
  "required": ["planning_artifact_meta", "project_spine"],
  "properties": {
    "planning_artifact_meta": { "$ref": "planning-artifact-meta.schema.json#/properties/planning_artifact_meta" },
    "project_spine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phases"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phase_id", "name", "core_question", "non_negotiable_milestones"],
            "properties": {
              "phase_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "core_question": { "type": "string", "minLength": 1 },
              "non_negotiable_milestones": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["milestone_id", "description", "irreversible_change", "exit_condition"],
                  "properties": {
                    "milestone_id": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "irreversible_change": { "type": "string", "minLength": 1 },
                    "exit_condition": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "flexible_elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["description"],
                  "properties": {
                    "description": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
