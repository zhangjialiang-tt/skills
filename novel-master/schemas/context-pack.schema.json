{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-pack.schema.json",
  "title": "ContextPack",
  "description": "Minimal context package contract for novel-master V1 (Contract §9)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_for_request",
    "project_snapshot",
    "current_state",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_for_request": {
      "type": "string",
      "minLength": 1
    },
    "project_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "title",
        "genre",
        "current_volume",
        "current_chapter",
        "current_story_phase"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "genre": { "type": "string", "minLength": 1 },
        "current_volume": { "type": "string" },
        "current_chapter": { "type": "string" },
        "current_story_phase": { "type": "string" }
      }
    },
    "current_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "location", "active_conflict", "protagonist_goal"],
      "properties": {
        "time": { "type": "string" },
        "location": { "type": "string" },
        "active_conflict": { "type": "string" },
        "protagonist_goal": { "type": "string" }
      }
    },
    "relevant_characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "current_status", "current_goal"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "current_status": { "type": "string" },
          "current_goal": { "type": "string" },
          "known_information": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relationship_changes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "relevant_canon": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "source_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string" },
          "source_ref": { "type": "string" }
        }
      }
    },
    "active_open_loops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "urgency", "source_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "urgency": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "source_ref": { "type": "string" }
        }
      }
    },
    "active_foreshadowing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "usage_constraint", "source_ref"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["planted", "reinforced", "partially_revealed"]
          },
          "usage_constraint": { "type": "string" },
          "source_ref": { "type": "string" }
        }
      }
    },
    "timeline_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "prohibited_conflicts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "style_constraints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "style_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global_defaults_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "revision"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "revision": { "type": "string", "minLength": 1 }
          }
        },
        "relevant_scene_modulations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["modulation_id", "overrides", "source_ref"],
            "properties": {
              "modulation_id": { "type": "string", "minLength": 1 },
              "overrides": { "type": "object", "additionalProperties": true },
              "source_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "omitted_context_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["substantive_characters", "estimated_tokens", "truncated"],
      "properties": {
        "substantive_characters": { "type": "integer", "minimum": 0 },
        "estimated_tokens": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "boolean" }
      }
    }
  }
}
