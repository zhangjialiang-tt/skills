{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "volume-arc.schema.json",
  "title": "VolumeArc",
  "description": "v1.3 VolumeArc — per-volume outline with arcs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["planning_artifact_meta", "volume_arc"],
  "properties": {
    "planning_artifact_meta": { "$ref": "planning-artifact-meta.schema.json#/properties/planning_artifact_meta" },
    "volume_arc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume_id", "phase_ref", "core_question", "irreversible_change", "reader_payoff", "target_chapter_count", "arcs"],
      "properties": {
        "volume_id": { "type": "string", "minLength": 1 },
        "phase_ref": { "$ref": "defs/plan-ref.schema.json#/definitions/plan_ref" },
        "core_question": { "type": "string", "minLength": 1 },
        "irreversible_change": { "type": "string", "minLength": 1 },
        "reader_payoff": { "type": "string", "minLength": 1 },
        "target_chapter_count": { "type": "integer", "minimum": 1 },
        "arcs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["arc_id", "name", "chapter_range", "function"],
            "properties": {
              "arc_id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "chapter_range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
              "function": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
