{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arc-plan.schema.json",
  "title": "ArcPlan",
  "description": "v1.3 ArcPlan — per-arc beat and payoff plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["planning_artifact_meta", "arc_plan"],
  "properties": {
    "planning_artifact_meta": { "$ref": "planning-artifact-meta.schema.json#/properties/planning_artifact_meta" },
    "arc_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arc_id", "volume_ref", "arc_goal", "dramatic_question", "required_beats", "exit_state"],
      "properties": {
        "arc_id": { "type": "string", "minLength": 1 },
        "volume_ref": { "$ref": "defs/plan-ref.schema.json#/definitions/plan_ref" },
        "arc_goal": { "type": "string", "minLength": 1 },
        "dramatic_question": { "type": "string", "minLength": 1 },
        "required_beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["beat_id", "description", "constraints"],
            "properties": {
              "beat_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "constraints": { "type": "string" }
            }
          }
        },
        "payoffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["payoff_id", "description", "delivery_criteria"],
            "properties": {
              "payoff_id": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "delivery_criteria": { "type": "string", "minLength": 1 }
            }
          }
        },
        "exit_state": { "type": "object", "additionalProperties": false, "minProperties": 1 }
      }
    }
  }
}
